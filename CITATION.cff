    given-names: Gaeun
    orcid: "https://orcid.org/0009-0001-1332-9206"
    affiliation: Independent researcher
version: "1.0"
date-released: 2026-08-19
license: CC-BY-4.0
url: "https://gaeunlim01.github.io/regulatory-order/"
repository-code: "https://github.com/GaeunLim01/regulatory-order"
keywords:
  - regulatory analysis
  - export control
  - AI governance
  - semiconductors
  - value chains

