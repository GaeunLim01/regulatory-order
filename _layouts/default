<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if page.title %}{{ page.title }} — {% endif %}{{ site.title }}</title>
<meta name="description" content="{{ page.description | default: site.description }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Newsreader:opsz,wght@6..72,400;6..72,500&family=Source+Sans+3:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ '/assets/css/main.css' | relative_url }}">
</head>
<body>
<a class="skip" href="#main">Skip to content</a>

<header class="masthead">
  <div class="shell masthead__inner">
    <a class="masthead__mark" href="{{ '/' | relative_url }}">
      REGULATORY&nbsp;ORDER<span class="masthead__ver">v4</span>
    </a>
    <nav class="nav" aria-label="Framework sections">
      <ul>
        {% for item in site.data.nav %}
        <li><a href="{{ item.url | relative_url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {% endfor %}
      </ul>
    </nav>
  </div>
</header>

<main id="main">
{{ content }}
</main>

<footer class="foot">
  <div class="shell">
    <div class="byline byline--foot">
      <div>
        <b>{{ site.data.author.name }}</b>
        <span>{{ site.data.author.title }}</span>
      </div>
      <ul>
        {% for link in site.data.author.links %}
        <li><a href="{{ link.url }}" rel="me noopener">{{ link.label }}</a></li>
        {% endfor %}
      </ul>
    </div>
    <p><b>Framework v4.</b> Content CC BY 4.0; site code MIT.</p>
  </div>
</footer>
</body>
</html>
